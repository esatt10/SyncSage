# SyncSage demo environment — copy to the REPO ROOT as `.env`, then edit.
#
#   cp examples/demo-agent-framework/.env.demo.example .env
#
# Compose auto-loads `.env` from the directory you run it in, so the key
# reaches the container without ever being written into a config file, the
# image, or /state. Keep `.env` out of git (it is already gitignored).

# ---------------------------------------------------------------------------
# REQUIRED — one key, used by BOTH the index path (embeddings) and chat.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# REQUIRED — host path to your clone of microsoft/agent-framework. It is
# mounted read-only at /workspace, which is what the demo config indexes.
#
#   git clone --depth 1 https://github.com/microsoft/agent-framework C:/src/agent-framework
#
# Windows paths work with forward slashes.
# ---------------------------------------------------------------------------
AGENT_FRAMEWORK_PATH=C:/src/agent-framework

# ---------------------------------------------------------------------------
# OPTIONAL — defaults are fine.
# ---------------------------------------------------------------------------
# Extras baked into the image. `agent` pulls langgraph + langchain-core, which
# the agentic answer loop needs; add `vector` if you switch the vector store to
# lancedb.
SYNCSAGE_EXTRAS=mcp,agent

# Bind address for the published ports. Loopback only unless you have put an
# authenticating proxy in front of the API.
SYNCSAGE_BIND=127.0.0.1

# UI port on the host (the API is always 8765).
SYNCSAGE_UI_PORT=8080
