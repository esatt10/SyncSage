{
  "$defs": {
    "Capabilities": {
      "description": "What Tier 2 may ask of the region.",
      "properties": {
        "api_version": {
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "auth": {
          "default": "none",
          "enum": [
            "none",
            "bearer"
          ],
          "title": "Auth",
          "type": "string"
        },
        "granularities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Granularities",
          "type": "array"
        },
        "modalities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Modalities",
          "type": "array"
        },
        "returns_vectors": {
          "default": false,
          "title": "Returns Vectors",
          "type": "boolean"
        },
        "search_modes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Search Modes",
          "type": "array"
        }
      },
      "title": "Capabilities",
      "type": "object"
    },
    "ConceptWeight": {
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "term",
        "weight"
      ],
      "title": "ConceptWeight",
      "type": "object"
    },
    "EmbeddingSpace": {
      "description": "Must match the fleet pin — the router rejects mismatches at register.",
      "properties": {
        "dim": {
          "exclusiveMinimum": 0,
          "title": "Dim",
          "type": "integer"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "normalized": {
          "default": true,
          "title": "Normalized",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "dim"
      ],
      "title": "EmbeddingSpace",
      "type": "object"
    },
    "Integrity": {
      "properties": {
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        }
      },
      "title": "Integrity",
      "type": "object"
    },
    "Signature": {
      "description": "The routing payload. All vectors are fp16-base64, length == dim.",
      "properties": {
        "centroid": {
          "title": "Centroid",
          "type": "string"
        },
        "cluster_centroids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Cluster Centroids",
          "type": "array"
        },
        "cluster_weights": {
          "items": {
            "type": "number"
          },
          "title": "Cluster Weights",
          "type": "array"
        },
        "covariance_diag": {
          "title": "Covariance Diag",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "centroid",
        "covariance_diag",
        "sample_count"
      ],
      "title": "Signature",
      "type": "object"
    },
    "Vocabulary": {
      "description": "Concept digest from the region's knowledge graph.",
      "properties": {
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "minhash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minhash"
        },
        "top_concepts": {
          "items": {
            "$ref": "#/$defs/ConceptWeight"
          },
          "maxItems": 256,
          "title": "Top Concepts",
          "type": "array"
        }
      },
      "title": "Vocabulary",
      "type": "object"
    },
    "Watermark": {
      "description": "Freshness block — changes iff region content changed.",
      "properties": {
        "artifact_count": {
          "minimum": 0,
          "title": "Artifact Count",
          "type": "integer"
        },
        "bytes_indexed": {
          "minimum": 0,
          "title": "Bytes Indexed",
          "type": "integer"
        },
        "chunk_count": {
          "minimum": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "last_sync_completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Sync Completed At"
        },
        "source_checkpoints_digest": {
          "title": "Source Checkpoints Digest",
          "type": "string"
        }
      },
      "required": [
        "source_checkpoints_digest",
        "artifact_count",
        "chunk_count",
        "bytes_indexed"
      ],
      "title": "Watermark",
      "type": "object"
    }
  },
  "$id": "https://github.com/esatt10/subjective-retrieval/contracts/semantic_contract.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned projection of a region's content, sized for router RAM.\n\n``schema_version`` is stamped by the canonical writer\n(:func:`write_contract`); readers go through :func:`load_contract`\nwhich applies the repo-wide v0 fallback (warn + treat as v0).",
  "properties": {
    "axiom_projections": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Axiom Projections",
      "type": "object"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "embedding_space": {
      "$ref": "#/$defs/EmbeddingSpace"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    },
    "fleet_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fleet Id"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    },
    "kb_id": {
      "title": "Kb Id",
      "type": "string"
    },
    "kind": {
      "const": "semantic_contract",
      "default": "semantic_contract",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    },
    "vocabulary": {
      "$ref": "#/$defs/Vocabulary"
    },
    "watermark": {
      "$ref": "#/$defs/Watermark"
    }
  },
  "required": [
    "kb_id",
    "generated_at",
    "watermark",
    "embedding_space",
    "signature"
  ],
  "title": "SemanticContract",
  "type": "object"
}
